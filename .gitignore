# Environment variables (API keys)
.env
apikey.txt

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Test / tooling caches (pytest regenerates these on every run)
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# Fuzzing & analysis artifacts — large, regenerated by benchmark.py
benchmark_workspace/fuzzing/
benchmark_workspace/triage/
benchmark_workspace/driller/
benchmark_workspace/cJSON/
*.casrep

# Compiled fuzz targets / sanitizer binaries
*.o
*.a
*.dSYM/

# Benchmark output. The measured summary lives in benchmark.md,
# which IS tracked; the per-run raw artifacts are not.
reports/benchmark_runs/

# Docker
.docker/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

web_dashboard_plan.md

# dashboard runtime data (job logs, uploaded repositories)
dashboard/runs/
dashboard/uploads/

# any env-file variant (e.g. ".env copy") can hold an API key
.env*

# run output and cloned third-party trees (large or nested repositories); regenerate with
# benchmark.py / tests/real_cve_suite/setup.sh
reports/auto_runs/
reports/benchmark_runs/
reports/*.log
reports/AB_index.txt
benchmark_workspace/cJSON_cve/
benchmark_workspace/real_cve_trees/
benchmark_workspace/zlib_cve/

# NodeGoat target tree — cloned by benchmarks/nodegoat/setup.sh, not committed
benchmark_workspace/NodeGoat/
# NodeGoat benchmark target (pinned clone; recreate with the plan in NODEGOAT_PLAN.md)
benchmark_workspace/nodegoat/

# held-out evaluation targets (clones)
benchmark_workspace/heldout/
