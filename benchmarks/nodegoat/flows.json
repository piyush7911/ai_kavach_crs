[
  { "name": "login-page",    "method": "GET",  "path": "/login",          "login_as": "none",
    "expect": { "status": 200, "body_regex": "name=\"userName\"" } },
  { "name": "signup-page",   "method": "GET",  "path": "/signup",         "login_as": "none",
    "expect": { "status": 200, "body_regex": "sign ?up" } },
  { "name": "dashboard",     "method": "GET",  "path": "/dashboard",      "login_as": "user",
    "expect": { "status": 200, "body_regex": "dashboard" } },
  { "name": "profile-view",  "method": "GET",  "path": "/profile",        "login_as": "user",
    "expect": { "status": 200, "body_regex": "first name" } },
  { "name": "profile-update","method": "POST", "path": "/profile",        "login_as": "user",
    "body": { "firstName": "John", "lastName": "Doe", "ssn": "123-45-6789", "dob": "2000-01-01",
              "address": "1 St", "bankAcc": "12345678", "bankRouting": "12345#" },
    "expect": { "status": 200, "body_regex": "first name" } },
  { "name": "contributions-view", "method": "GET", "path": "/contributions", "login_as": "user",
    "expect": { "status": 200, "body_regex": "contribution" } },
  { "name": "contributions-update", "method": "POST", "path": "/contributions", "login_as": "user",
    "body": { "preTax": "5", "afterTax": "5", "roth": "5" },
    "expect": { "status": 200, "body_regex": ">5 %<" } },
  { "name": "allocations",   "method": "GET",  "path": "/allocations/2",  "login_as": "user",
    "expect": { "status": 200, "body_regex": "allocation" } },
  { "name": "memos",         "method": "GET",  "path": "/memos",          "login_as": "user",
    "expect": { "status": 200, "body_regex": "memo" } },
  { "name": "research",      "method": "GET",  "path": "/research",       "login_as": "user",
    "expect": { "status": 200, "body_regex": "research" } },
  { "name": "benefits",      "method": "GET",  "path": "/benefits",       "login_as": "admin",
    "expect": { "status": 200, "body_regex": "benefit" } },
  { "name": "learn-legit-redirect", "method": "GET", "path": "/learn?url=/tutorial", "login_as": "user",
    "expect": { "status": 302, "redirect_regex": "^/tutorial" } },
  { "name": "logout",        "method": "GET",  "path": "/logout",         "login_as": "user",
    "expect": { "status": 302, "redirect_regex": "/$" } }
]
